generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  company     String
  description String
  rating      Float    @default(5.0)
  logo        String
  logoAlt     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  image       String
  link        String?
  routerLink  String?
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  logo      String
  alt       String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  type      String   @default("contact") // "contact" | "lets_talk"
  status    String   @default("pending") // "pending" | "contacted" | "closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inquiries")
}

model SiteSettings {
  id           String   @id @default(cuid())
  email        String   @default("hello@cairocodestudio.com")
  phone        String   @default("+201000 60 9719")
  whatsapp     String?
  address      String   @default("Nasr City, Cairo, Egypt")
  workingHours String?  @default("Sun - Thu: 9:00 AM - 6:00 PM")
  facebook     String?  @default("https://www.facebook.com/cairocodestudio")
  instagram    String?  @default("https://www.instagram.com/cairocodestudio")
  linkedin     String?  @default("https://www.linkedin.com/company/cairo-code-studio/")
  twitter      String?
  github       String?
  behance      String?
  dribbble     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}
